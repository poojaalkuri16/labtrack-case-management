# --- Database (optional) ---------------------------------------------
# Leave empty: local dev uses ./local.db, Vercel falls back to /tmp (resets on cold start, auto-reseeds).
# For a persistent deployment create a free Turso database and set both:
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Email (optional) ------------------------------------------------
# Without RESEND_API_KEY the app runs in TEST MODE: emails are rendered and saved to the Outbox, nothing is sent.
RESEND_API_KEY=
NOTIFY_FROM="LabTrack <onboarding@resend.dev>"
# Force test mode even if a key is present
NOTIFY_MODE=

# --- Lab ---------------------------------------------------------------
# IANA timezone of the lab. "Today" and "overdue" are decided here, never in the viewer's timezone.
LAB_TIMEZONE=Europe/Berlin
NEXT_PUBLIC_APP_URL=

# --- Demo ---------------------------------------------------------------
# A "Reset demo data" control is shown on the Cases page. Set to "off" for anything real.
DEMO_RESET=
